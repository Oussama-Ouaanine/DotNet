@model LibraryWebApp.Models.ViewModels.Account.LoginInputModel
@{
    ViewData["Title"] = "Sign in";
}

<section class="section-width" style="padding: 6rem 0 4rem;">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card" style="padding: 2.5rem;">
                <h2 style="margin-bottom: 0.75rem;">Welcome back</h2>
                <p style="margin-bottom: 2.5rem;">Sign in to manage your reservations and pick up where you left off.</p>

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label"></label>
                        </div>
                        <a class="btn btn-link-style" href="#">Forgot password?</a>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Sign in</button>
                </form>

                <hr style="margin: 2.5rem 0;" />
                <p class="text-center text-muted mb-0">New to Lumen Library? <a asp-action="Register">Create an account</a>.</p>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
