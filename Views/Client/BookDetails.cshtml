@model LibraryWebApp.Models.Book

@{
    ViewData["Title"] = "Book Details";
}

<h1>Book Details</h1>

<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="col-md-4">
                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <img src="@Model.ImagePath" alt="@Model.Title cover" class="img-fluid rounded" style="max-height: 400px; object-fit: cover;" />
                }
                else
                {
                    <div class="bg-secondary d-flex align-items-center justify-content-center rounded" style="height: 400px;">
                        <span class="text-white">No Cover Image</span>
                    </div>
                }
            </div>
            <div class="col-md-8">
                <h2 class="card-title">@Model.Title</h2>
                <h4 class="card-subtitle mb-3 text-muted">by @Model.Author</h4>
                
                <div class="mb-3">
                    <p><strong>Category:</strong> @Model.Category</p>
                    <p><strong>ISBN:</strong> @Model.ISBN</p>
                    <p><strong>Publication Year:</strong> @Model.PublicationYear</p>
                    <p><strong>Available Copies:</strong> @Model.AvailableCopies out of @Model.TotalCopies</p>
                    <p>
                        <strong>Status:</strong>
                        @if (Model.AvailableCopies > 0)
                        {
                            <span class="badge bg-success">Available</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Unavailable</span>
                        }
                    </p>
                </div>
                
                <div class="mb-3">
                    <h5>Description</h5>
                    <p>@(string.IsNullOrEmpty(Model.Description) ? "No description available." : Model.Description)</p>
                </div>
                
                <div class="mt-3">
                    @if (Model.AvailableCopies > 0)
                    {
                        <form method="post" asp-action="BookABook" asp-route-id="@Model.Id" style="display:inline;">
                            <button type="submit" class="btn btn-success">Book This Book</button>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-secondary" disabled>Currently Unavailable</button>
                    }
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                </div>
            </div>
        </div>
    </div>
</div>
