@model IEnumerable<LibraryWebApp.Models.Book>

@{
    ViewData["Title"] = "Browse Books";
}

<h1>Browse All Books</h1>

<div class="row">
    @foreach (var book in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                @if (!string.IsNullOrEmpty(book.ImagePath))
                {
                    <img src="@book.ImagePath" class="card-img-top" alt="@book.Title cover" style="height: 300px; object-fit: cover;" />
                }
                else
                {
                    <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 300px;">
                        <span class="text-white">No Cover Image</span>
                    </div>
                }
                <div class="card-body">
                    <h5 class="card-title">@book.Title</h5>
                    <h6 class="card-subtitle mb-2 text-muted">by @book.Author</h6>
                    <p class="card-text">
                        <strong>Category:</strong> @book.Category<br />
                        <strong>ISBN:</strong> @book.ISBN<br />
                        <strong>Year:</strong> @book.PublicationYear<br />
                        <strong>Available:</strong> @book.AvailableCopies / @book.TotalCopies
                    </p>
                </div>
                <div class="card-footer">
                    <a asp-action="BookDetails" asp-route-id="@book.Id" class="btn btn-sm btn-info">Details</a>
                    @if (book.AvailableCopies > 0)
                    {
                        <form method="post" asp-action="BookABook" asp-route-id="@book.Id" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-success">Book Now</button>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-secondary" disabled>Unavailable</button>
                    }
                </div>
            </div>
        </div>
    }
</div>
