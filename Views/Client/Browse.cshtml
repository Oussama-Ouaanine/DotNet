@model LibraryWebApp.Models.ViewModels.Client.ClientBrowseViewModel
@{
    ViewData["Title"] = "Browse";
}

<section class="section-width" style="padding: 4rem 0 2rem;">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <small>Collections</small>
            <h1 style="margin: 0.5rem 0 0;">Browse by theme</h1>
        </div>
        <a asp-action="Search" class="btn btn-outline-primary">Search titles</a>
    </div>

    <div class="d-grid gap-4">
        @foreach (var collection in Model.Sections)
        {
            <div class="card" style="padding: 2.5rem;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <strong>@collection.Category.Icon @collection.Category.Name</strong>
                        <p style="margin: 0; color: var(--text-tertiary);">@collection.Category.Description</p>
                    </div>
                </div>
                <div class="row g-4">
                    @foreach (var book in collection.Books)
                    {
                        <div class="col-md-4">
                            <div class="card" style="padding: 1.5rem; height: 100%;">
                                <strong>@book.Title</strong>
                                <p style="margin: 0.5rem 0;">@book.Author</p>
                                <small>@book.CategoryName</small>
                                <div class="d-flex gap-2 mt-3">
                                    <a asp-action="BookDetails" asp-route-id="@book.Id" class="btn btn-outline-primary btn-sm">Details</a>
                                    <form asp-action="Reserve" method="post" asp-route-id="@book.Id">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-primary btn-sm" @(book.IsAvailable ? string.Empty : "disabled")>
                                            @(book.IsAvailable ? "Reserve" : "Reserved")
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>
