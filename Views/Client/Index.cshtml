@model LibraryWebApp.Models.ViewModels.Client.ClientHomeViewModel
@{
    ViewData["Title"] = "Discover";
}

<section class="section-width" style="padding: 4rem 0 2rem;">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <small>Your space</small>
            <h1 style="margin: 0.5rem 0 0;">Curated for you</h1>
        </div>
        <a asp-action="Search" class="btn btn-outline-primary">Advanced search</a>
    </div>

    <div class="card" style="padding: 2.5rem; margin-bottom: 2rem;">
        <h3 style="margin-bottom: 1.5rem;">Featured this week</h3>
        <div class="row g-4">
            @foreach (var book in Model.FeaturedBooks)
            {
                <div class="col-md-4">
                    <div class="card" style="padding: 1.5rem; height: 100%;">
                        <div style="width: 100%; height: 220px; border-radius: 18px; overflow: hidden; background: var(--surface-muted); margin-bottom: 1.5rem;">
                            <img src="@(string.IsNullOrWhiteSpace(book.CoverImagePath) ? "https://images.unsplash.com/photo-1528109086351-0b07c1145f35?auto=format&fit=crop&w=400&q=80" : book.CoverImagePath)" alt="@book.Title cover" style="width: 100%; height: 100%; object-fit: cover;" />
                        </div>
                        <strong>@book.Title</strong>
                        <p style="margin: 0.5rem 0 1rem;">@book.Author</p>
                        <a asp-action="BookDetails" asp-route-id="@book.Id" class="btn btn-outline-primary btn-sm">View details</a>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="card" style="padding: 2.5rem;">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 style="margin: 0;">Trending now</h3>
            <a asp-action="Browse" class="btn btn-link-style">Browse all</a>
        </div>
        <div class="row g-4">
            @foreach (var book in Model.TrendingBooks)
            {
                <div class="col-md-3">
                    <div class="card" style="padding: 1.5rem; height: 100%;">
                        <strong>@book.Title</strong>
                        <p style="margin: 0.5rem 0;">@book.Author</p>
                        <small>@book.CategoryName</small>
                        <a asp-action="BookDetails" asp-route-id="@book.Id" class="btn btn-link-style" style="margin-top: 1rem;">Reserve</a>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
