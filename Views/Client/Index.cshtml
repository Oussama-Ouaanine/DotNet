@model IEnumerable<LibraryWebApp.Models.Book>

@{
    ViewData["Title"] = "Client Home";
}

<h1>Welcome to the Library</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row mb-3">
    <div class="col-md-12">
        <form method="get" asp-controller="Client" asp-action="Search" class="d-flex">
            <input type="text" name="searchTerm" class="form-control me-2" placeholder="Search books by title, author, or ISBN" />
            <button type="submit" class="btn btn-primary">Search</button>
        </form>
    </div>
</div>

<h2>Available Books</h2>

<div class="row">
    @foreach (var book in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                @if (!string.IsNullOrEmpty(book.ImagePath))
                {
                    <img src="@book.ImagePath" class="card-img-top" alt="@book.Title cover" style="height: 300px; object-fit: cover;" />
                }
                else
                {
                    <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 300px;">
                        <span class="text-white">No Cover Image</span>
                    </div>
                }
                <div class="card-body">
                    <h5 class="card-title">@book.Title</h5>
                    <h6 class="card-subtitle mb-2 text-muted">by @book.Author</h6>
                    <p class="card-text">
                        <strong>Category:</strong> @book.Category<br />
                        <strong>ISBN:</strong> @book.ISBN<br />
                        <strong>Available Copies:</strong> @book.AvailableCopies
                    </p>
                    @if (!string.IsNullOrEmpty(book.Description))
                    {
                        <p class="card-text">@(book.Description.Length > 100 ? book.Description.Substring(0, 100) + "..." : book.Description)</p>
                    }
                </div>
                <div class="card-footer">
                    <a asp-action="BookDetails" asp-route-id="@book.Id" class="btn btn-sm btn-info">Details</a>
                    @if (book.AvailableCopies > 0)
                    {
                        <form method="post" asp-action="BookABook" asp-route-id="@book.Id" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-success">Book Now</button>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-secondary" disabled>Unavailable</button>
                    }
                </div>
            </div>
        </div>
    }
</div>
