@model IEnumerable<LibraryWebApp.Models.Book>

@{
    ViewData["Title"] = "Search Books";
}

<h1>Search Books</h1>

<div class="row mb-4">
    <div class="col-md-12">
        <form method="get" asp-action="Search">
            <div class="input-group">
                <input type="text" name="searchTerm" class="form-control" value="@ViewBag.SearchTerm" placeholder="Search by title, author, or ISBN" />
                <button type="submit" class="btn btn-primary">Search</button>
            </div>
        </form>
    </div>
</div>

@if (ViewBag.SearchTerm != null)
{
    <h3>Search Results for "@ViewBag.SearchTerm"</h3>
    
    @if (!Model.Any())
    {
        <div class="alert alert-info">No books found matching your search criteria.</div>
    }
    else
    {
        <div class="row">
            @foreach (var book in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">@book.Title</h5>
                            <h6 class="card-subtitle mb-2 text-muted">by @book.Author</h6>
                            <p class="card-text">
                                <strong>Category:</strong> @book.Category<br />
                                <strong>ISBN:</strong> @book.ISBN<br />
                                <strong>Available:</strong> @book.AvailableCopies / @book.TotalCopies
                            </p>
                        </div>
                        <div class="card-footer">
                            <a asp-action="BookDetails" asp-route-id="@book.Id" class="btn btn-sm btn-info">Details</a>
                            @if (book.AvailableCopies > 0)
                            {
                                <form method="post" asp-action="BookABook" asp-route-id="@book.Id" style="display:inline;">
                                    <button type="submit" class="btn btn-sm btn-success">Book Now</button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-secondary" disabled>Unavailable</button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
