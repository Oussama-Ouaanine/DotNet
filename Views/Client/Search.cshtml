@model LibraryWebApp.Models.ViewModels.Client.SearchResultsViewModel
@{
    ViewData["Title"] = "Search";
}

<section class="section-width" style="padding: 4rem 0 2rem;">
    <div class="mb-4">
        <small>Search</small>
        <h1 style="margin: 0.5rem 0 0;">Find your next book</h1>
    </div>

    <form method="get" class="card" style="padding: 1.5rem; margin-bottom: 2rem;">
        <div class="row g-3 align-items-center">
            <div class="col-lg-10">
                <input type="text" name="query" value="@Model.Query" class="form-control" placeholder="Search by title, author, or theme" />
            </div>
            <div class="col-lg-2 d-grid">
                <button class="btn btn-primary" type="submit">Search</button>
            </div>
        </div>
    </form>

    <div class="card" style="padding: 2.5rem;">
        @if (!Model.HasResults)
        {
            <p style="margin: 0;">No results yet. Try searching for "Design", "Leadership", or "Science".</p>
        }
        else
        {
            <div class="row g-4">
                @foreach (var book in Model.Results)
                {
                    <div class="col-md-4">
                        <div class="card" style="padding: 1.5rem; height: 100%;">
                            <strong>@book.Title</strong>
                            <p style="margin: 0.5rem 0;">@book.Author</p>
                            <small>@book.CategoryName</small>
                            <div class="d-flex gap-2 mt-3">
                                <a asp-action="BookDetails" asp-route-id="@book.Id" class="btn btn-outline-primary btn-sm">Details</a>
                                <form asp-action="Reserve" method="post" asp-route-id="@book.Id">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-primary btn-sm" @(book.IsAvailable ? string.Empty : "disabled")>
                                        @(book.IsAvailable ? "Reserve" : "Reserved")
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
