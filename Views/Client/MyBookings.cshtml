@model LibraryWebApp.Models.ViewModels.Client.MyBookingsViewModel
@using System.Linq
@{
    ViewData["Title"] = "My bookings";
}

<section class="section-width" style="padding: 4rem 0 2rem;">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <small>Your activity</small>
            <h1 style="margin: 0.5rem 0 0;">Reservations</h1>
        </div>
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        var statusType = TempData["StatusType"] as string;
        var alertClass = statusType == "error" ? "alert-danger" : "alert-success";
        <div class="alert @alertClass" role="alert">@statusMessage</div>
    }

    <div class="card" style="padding: 2.5rem; margin-bottom: 2rem;">
        <h3 style="margin-bottom: 1.5rem;">Pending approval</h3>
        <div class="d-grid gap-3">
            @if (!Model.Pending.Any())
            {
                <p style="margin: 0;">No pending requests. Browse the <a asp-action="Browse">catalogue</a> to reserve a title.</p>
            }
            else
            {
                foreach (var booking in Model.Pending)
                {
                    <div class="card" style="padding: 1.5rem;">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <strong>@booking.BookTitle</strong>
                                <p style="margin: 0.25rem 0 0; color: var(--text-tertiary);">Requested @booking.CreatedAt.ToLocalTime().ToString("dd MMM yyyy") • Awaiting admin approval</p>
                            </div>
                            <span class="badge bg-warning text-dark">Pending</span>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <div class="card" style="padding: 2.5rem; margin-bottom: 2rem;">
        <h3 style="margin-bottom: 1.5rem;">Approved & checked out</h3>
        <div class="d-grid gap-3">
            @if (!Model.Approved.Any())
            {
                <p style="margin: 0;">No approved reservations yet.</p>
            }
            else
            {
                foreach (var booking in Model.Approved)
                {
                    <div class="card" style="padding: 1.5rem;">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <strong>@booking.BookTitle</strong>
                                <p style="margin: 0.25rem 0 0; color: var(--text-tertiary);">Due back @booking.DueDate?.ToLocalTime().ToString("dd MMM yyyy")</p>
                            </div>
                            <span class="badge bg-dark">Approved</span>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <div class="card" style="padding: 2.5rem;">
        <h3 style="margin-bottom: 1.5rem;">History</h3>
        <div class="d-grid gap-3">
            @if (!Model.History.Any())
            {
                <p style="margin: 0;">No past reservations yet.</p>
            }
            else
            {
                foreach (var booking in Model.History)
                {
                    var badgeClass = booking.Status == BookingStatus.Refused ? "badge bg-danger" : "badge bg-secondary";
                    var statusLabel = booking.Status == BookingStatus.Refused ? "Refused" : "Completed";
                    <div class="card" style="padding: 1.5rem;">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <strong>@booking.BookTitle</strong>
                                @if (booking.Status == BookingStatus.Refused)
                                {
                                    <p style="margin: 0.25rem 0 0; color: var(--text-tertiary);">Request was declined on @booking.ReturnedAt?.ToLocalTime().ToString("dd MMM yyyy")</p>
                                }
                                else
                                {
                                    <p style="margin: 0.25rem 0 0; color: var(--text-tertiary);">Returned @booking.ReturnedAt?.ToLocalTime().ToString("dd MMM yyyy")</p>
                                }
                            </div>
                            <span class="@badgeClass">@statusLabel</span>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>
