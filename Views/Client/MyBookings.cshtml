@model IEnumerable<LibraryWebApp.Models.Booking>

@{
    ViewData["Title"] = "My Bookings";
}

<h1>My Bookings</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">You don't have any bookings yet.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Booking ID</th>
                <th>Book Title</th>
                <th>Booking Date</th>
                <th>Due Date</th>
                <th>Return Date</th>
                <th>Status</th>
                <th>Late Fee</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model)
            {
                <tr>
                    <td>@booking.BookingId</td>
                    <td>@booking.BookTitle</td>
                    <td>@booking.BookingDate.ToString("dd/MM/yyyy")</td>
                    <td>@booking.DueDate.ToString("dd/MM/yyyy")</td>
                    <td>@(booking.ReturnDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                    <td>
                        @switch (booking.Status)
                        {
                            case "Pending":
                                <span class="badge bg-warning">@booking.Status</span>
                                break;
                            case "Active":
                                <span class="badge bg-info">@booking.Status</span>
                                break;
                            case "Declined":
                                <span class="badge bg-danger">@booking.Status</span>
                                break;
                            case "Returned":
                                <span class="badge bg-success">@booking.Status</span>
                                break;
                            case "Overdue":
                                <span class="badge bg-danger">@booking.Status</span>
                                break;
                        }
                    </td>
                    <td>@(booking.LateFee > 0 ? "$" + booking.LateFee.ToString("0.00") : "-")</td>
                    <td>
                        @if (booking.Status == "Pending")
                        {
                            <form method="post" asp-action="CancelBooking" asp-route-id="@booking.Id" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to cancel this booking?')">Cancel</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
