@using Microsoft.AspNetCore.Mvc.Rendering
@model LibraryWebApp.Models.ViewModels.Admin.BookFormModel
@{
    ViewData["Title"] = "Add new book";
}

<section class="section-width" style="padding: 4rem 0 2rem;">
    <div class="mb-4">
        <a asp-action="Books" class="btn btn-link-style">← Back to catalogue</a>
        <h1 style="margin-top: 0.75rem;">Add a new title</h1>
        <p style="max-width: 560px;">Upload cover art, define metadata, and set the tone for your readers. Every detail helps the experience feel more curated.</p>
    </div>

    <div class="card" style="padding: 2.5rem;">
        <form asp-action="CreateBook" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="row g-4">
                <div class="col-lg-7">
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Author" class="form-label"></label>
                        <input asp-for="Author" class="form-control" />
                        <span asp-validation-for="Author" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label"></label>
                        <select asp-for="CategoryId" asp-items="@(new SelectList(Model.Categories, "Id", "Name"))" class="form-select"></select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="mb-3">
                        <label class="form-label">Cover art</label>
                        <input type="file" name="coverImage" accept="image/*" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="PublishedYear" class="form-label"></label>
                        <input asp-for="PublishedYear" class="form-control" />
                        <span asp-validation-for="PublishedYear" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Pages" class="form-label"></label>
                        <input asp-for="Pages" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Rating" class="form-label"></label>
                        <input asp-for="Rating" class="form-control" step="0.1" min="0" max="5" />
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input asp-for="IsAvailable" class="form-check-input" />
                        <label asp-for="IsAvailable" class="form-check-label"></label>
                    </div>
                    <div class="form-check form-switch mb-4">
                        <input asp-for="IsFeatured" class="form-check-input" />
                        <label asp-for="IsFeatured" class="form-check-label">Feature on homepage</label>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Publish title</button>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
