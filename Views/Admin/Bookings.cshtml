@model IEnumerable<LibraryWebApp.Models.Booking>
@using System.Linq
@{
    ViewData["Title"] = "Reservations";
}

<section class="section-width" style="padding: 4rem 0 2rem;">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <small>Reservations</small>
            <h1 style="margin: 0.5rem 0 0;">Live activity</h1>
        </div>
        <a asp-action="History" class="btn btn-outline-primary">View Full History</a>
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        var statusType = TempData["StatusType"] as string;
        var alertClass = statusType == "error" ? "alert-danger" : "alert-success";
        <div class="alert @alertClass" role="alert">@statusMessage</div>
    }

    <div class="card" style="padding: 0; overflow: hidden;">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Book</th>
                    <th>Member</th>
                    <th>Reserved</th>
                    <th>Due</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4">No reservations yet.</td>
                    </tr>
                }
                else
                {
                    foreach (var booking in Model)
                    {
                        var statusClass = booking.Status switch
                        {
                            BookingStatus.Pending => "badge bg-warning text-dark",
                            BookingStatus.Approved => "badge bg-dark",
                            BookingStatus.Completed => "badge bg-secondary",
                            BookingStatus.Refused => "badge bg-danger",
                            _ => "badge bg-light text-dark"
                        };
                        <tr>
                            <td>@booking.BookTitle</td>
                            <td>@booking.Username</td>
                            <td>@booking.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td>@(booking.DueDate?.ToLocalTime().ToString("dd MMM yyyy") ?? "—")</td>
                            <td><span class="@statusClass">@booking.Status</span></td>
                            <td class="text-end">
                                @if (booking.Status == BookingStatus.Pending)
                                {
                                    <div class="d-flex flex-column flex-lg-row gap-2 justify-content-end align-items-lg-center">
                                        <form asp-action="ApproveBooking" method="post" class="d-flex gap-2 align-items-center flex-wrap justify-content-end">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@booking.Id" />
                                            <input type="date" name="dueDate" class="form-control form-control-sm" required min="@DateTime.UtcNow.ToString("yyyy-MM-dd")" style="width: 180px;" />
                                            <button type="submit" class="btn btn-primary btn-sm">Approve</button>
                                        </form>
                                        <form asp-action="RefuseBooking" method="post" onsubmit="return confirm('Decline this reservation request?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@booking.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm">Refuse</button>
                                        </form>
                                    </div>
                                }
                                else if (booking.Status == BookingStatus.Approved)
                                {
                                    <form asp-action="CompleteBooking" method="post" class="d-inline" onsubmit="return confirm('Mark this booking as returned?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@booking.Id" />
                                        <button type="submit" class="btn btn-outline-secondary btn-sm">Mark returned</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
