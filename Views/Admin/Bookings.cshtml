@model IEnumerable<LibraryWebApp.Models.Booking>

@{
    ViewData["Title"] = "Manage Bookings";
}

<h1>Manage Bookings</h1>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link active" data-bs-toggle="tab" href="#pending">Pending</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#active">Active</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#all">All</a>
    </li>
</ul>

<div class="tab-content">
    <div id="pending" class="tab-pane fade show active">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Booking ID</th>
                    <th>User</th>
                    <th>Book</th>
                    <th>Booking Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model.Where(b => b.Status == "Pending"))
                {
                    <tr>
                        <td>@booking.BookingId</td>
                        <td>@booking.Username</td>
                        <td>@booking.BookTitle</td>
                        <td>@booking.BookingDate.ToString("dd/MM/yyyy")</td>
                        <td><span class="badge bg-warning">@booking.Status</span></td>
                        <td>
                            <form method="post" asp-action="ApproveBooking" asp-route-id="@booking.Id" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-success">Approve</button>
                            </form>
                            <form method="post" asp-action="DeclineBooking" asp-route-id="@booking.Id" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-danger">Decline</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    <div id="active" class="tab-pane fade">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Booking ID</th>
                    <th>User</th>
                    <th>Book</th>
                    <th>Due Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model.Where(b => b.Status == "Active" || b.Status == "Overdue"))
                {
                    <tr>
                        <td>@booking.BookingId</td>
                        <td>@booking.Username</td>
                        <td>@booking.BookTitle</td>
                        <td>@booking.DueDate.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (booking.Status == "Overdue")
                            {
                                <span class="badge bg-danger">@booking.Status</span>
                            }
                            else
                            {
                                <span class="badge bg-info">@booking.Status</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    <div id="all" class="tab-pane fade">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Booking ID</th>
                    <th>User</th>
                    <th>Book</th>
                    <th>Booking Date</th>
                    <th>Due Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model)
                {
                    <tr>
                        <td>@booking.BookingId</td>
                        <td>@booking.Username</td>
                        <td>@booking.BookTitle</td>
                        <td>@booking.BookingDate.ToString("dd/MM/yyyy")</td>
                        <td>@booking.DueDate.ToString("dd/MM/yyyy")</td>
                        <td>
                            @switch (booking.Status)
                            {
                                case "Pending":
                                    <span class="badge bg-warning">@booking.Status</span>
                                    break;
                                case "Active":
                                    <span class="badge bg-info">@booking.Status</span>
                                    break;
                                case "Declined":
                                    <span class="badge bg-danger">@booking.Status</span>
                                    break;
                                case "Returned":
                                    <span class="badge bg-success">@booking.Status</span>
                                    break;
                                case "Overdue":
                                    <span class="badge bg-danger">@booking.Status</span>
                                    break;
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
