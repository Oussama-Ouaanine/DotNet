@model LibraryWebApp.Models.Category

@{
    ViewData["Title"] = "Add New Category";
}

<h1>Add New Category</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post" asp-action="CreateCategory">
            @Html.AntiForgeryToken()
            
            <div class="mb-3">
                <label asp-for="CategoryName" class="form-label"></label>
                <input asp-for="CategoryName" class="form-control" />
                <span asp-validation-for="CategoryName" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            </div>
            
            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-action="Categories" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
