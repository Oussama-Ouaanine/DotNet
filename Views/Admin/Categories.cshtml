@model IEnumerable<LibraryWebApp.Models.Category>
@{
    ViewData["Title"] = "Categories";
}

<section class="section-width" style="padding: 4rem 0 2rem;">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <small>Taxonomy</small>
            <h1 style="margin: 0.5rem 0 0;">Curate categories</h1>
        </div>
    </div>

    @if (TempData["StatusMessage"] is string status)
    {
        <div class="alert alert-success">@status</div>
    }

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card" style="padding: 2rem;">
                <h3 style="margin-bottom: 1.5rem;">Active categories</h3>
                <div class="d-grid gap-3">
                    @foreach (var category in Model)
                    {
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <strong>@category.Icon @category.Name</strong>
                                <p style="margin: 0; color: var(--text-tertiary);">@category.Description</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card" style="padding: 2rem;">
                <h3 style="margin-bottom: 1.5rem;">Create category</h3>
                <form asp-action="CreateCategory" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" name="name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Icon (optional)</label>
                        <input type="text" name="icon" class="form-control" placeholder="◎" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Description</label>
                        <textarea name="description" class="form-control" rows="3"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Add category</button>
                </form>
            </div>
        </div>
    </div>
</section>
